@page "/productos"
@attribute [Authorize]
@implements IDisposable

@using PedidoNet.UI.Shared.Models.Productos
@using PedidoNet.UI.Shared.Offline
@using PedidoNet.UI.Shared.Offline.Productos
@using PedidoNet.UI.Shared.Productos
@using PedidoNet.UI.Shared.Device

@inject IProductoService ProductoService
@inject ProductoSyncService ProductoSync
@inject IConnectivityService Connectivity
@inject NavigationManager Navigation
@inject IBarcodeScannerService Scanner

<PageTitle>Productos - PedidoNet</PageTitle>

<div class="container-fluid px-3 px-md-4 py-4">

    <PageHeader Title="Catálogo de productos"
                Description="Administra los productos disponibles.">

        <Actions>
            @* Solo en la app móvil (en Web IsSupported = false) *@
            @if (Scanner.IsSupported)
            {
                <button type="button"
                        class="btn btn-outline-primary px-3 me-2"
                        disabled="@escaneando"
                        @onclick="EscanearProductoAsync">
                    @(escaneando ? "Escaneando..." : "Escanear código")
                </button>
            }

            <AuthorizeView Roles="Administrador">
                <button type="button"
                        class="btn btn-primary px-3"
                        @onclick="NuevoProducto">
                    Nuevo producto
                </button>
            </AuthorizeView>
        </Actions>

    </PageHeader>

    @if (codigoNoEncontrado is not null)
    {
        <div class="alert alert-warning d-flex flex-column flex-sm-row gap-2 justify-content-between align-items-sm-center">
            <span>No hay ningún producto con el código <strong>@codigoNoEncontrado</strong>.</span>

            <div class="d-flex gap-2">
                <AuthorizeView Roles="Administrador">
                    <button type="button"
                            class="btn btn-sm btn-primary"
                            @onclick="CrearConCodigoEscaneado">
                        Crear producto
                    </button>
                </AuthorizeView>

                <button type="button"
                        class="btn btn-sm btn-outline-secondary"
                        @onclick="() => codigoNoEncontrado = null">
                    Cerrar
                </button>
            </div>
        </div>
    }

    @if (!Connectivity.IsOnline)
    {
        <div class="offline-banner mb-4">
            <div>
                <div class="fw-bold">
                    Estás trabajando sin conexión.
                </div>

                <div class="small">
                    Los cambios se guardarán localmente y se sincronizarán cuando vuelva la conexión.
                </div>
            </div>
        </div>
    }

    @if (isLoading)
    {
        <LoadingIndicator Message="Cargando productos..." />
    }
    else if (errorMessage is not null)
    {
        <AlertMessage Message="@errorMessage"
                      Dismissible="false" />
    }
    else if (productos.Count == 0)
    {
        <AlertMessage Variant="info"
                      Message="No hay productos registrados."
                      Dismissible="false" />
    }
    else
    {
        <DataTable TItem="ProductosDto"
                   Items="@productos"
                   ColumnCount="7"
                   EmptyMessage="No hay productos registrados.">

            <Header>
                <th>Código</th>
                <th>Producto</th>
                <th>Precio</th>
                <th>Existencias</th>
                <th>IVA</th>
                <th>ISC</th>
                <th>Acciones</th>
            </Header>

            <RowTemplate Context="producto">

                <td>@producto.Codigo</td>

                <td class="fw-semibold">
                    @producto.Nombre

                    @if (producto.SyncStatus == SyncStatus.Failed)
                    {
                        <span class="badge text-bg-danger ms-2"
                              title="Edita o elimina el producto para volver a intentarlo.">
                            Error de sincronización
                        </span>
                    }
                    else if (producto.PendingSync)
                    {
                        <span class="badge text-bg-warning ms-2">
                            Pendiente
                        </span>
                    }
                </td>

                <td class="text-end">
                    @producto.PrecioVenta.ToString("N2")
                </td>

                <td class="text-center">
                    @producto.Existencias
                </td>

                <td class="text-center">
                    @(producto.TieneIVA == true ? "Sí" : "No")
                </td>

                <td class="text-center">
                    @(producto.TieneISC == true ? "Sí" : "No")
                </td>

                <td class="text-end">

                    <button type="button"
                            class="btn btn-sm btn-outline-primary me-2"
                            @onclick="@(() => OnEditar(producto))">
                        Editar
                    </button>

                    <button type="button"
                            class="btn btn-sm btn-outline-danger"
                            @onclick="@(() => OnEliminar(producto))">
                        Eliminar
                    </button>

                </td>

            </RowTemplate>

        </DataTable>
    }

</div>

@code {

    private readonly SemaphoreSlim _loadLock =
        new(1, 1);

    private List<ProductosDto> productos = [];

    private bool isLoading = true;

    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        Connectivity.ConnectivityChanged +=
            OnConnectivityChanged;

        await CargarProductosAsync();
    }

    private void OnEditar(ProductosDto producto)
    {
        Navigation.NavigateTo(
            $"/productos/editar/{producto.LocalId}");
    }

    private async Task OnEliminar(ProductosDto producto)
    {
        try
        {
            errorMessage = null;

            await ProductoService.EliminarAsync(
                producto.LocalId);

            await CargarProductosAsync();
        }
        catch (UnauthorizedAccessException)
        {
            Navigation.NavigateTo("/login");
        }
        catch (Exception e)
        {
            errorMessage =
                $"No fue posible eliminar el producto: {e.Message}";
        }
    }

    private async Task CargarProductosAsync()
    {
        await _loadLock.WaitAsync();

        try
        {
            isLoading = true;
            errorMessage = null;

            productos =
                await ProductoService.ObtenerTodosAsync();
        }
        catch (UnauthorizedAccessException)
        {
            Navigation.NavigateTo("/login");
        }
        catch (HttpRequestException e)
        {
            errorMessage =
                $"No fue posible consultar los productos: {e.Message}";
        }
        catch (Exception e)
        {
            errorMessage =
                $"Error inesperado: {e.Message}";
        }
        finally
        {
            isLoading = false;

            _loadLock.Release();
        }
    }

    private bool escaneando;
    private string? codigoNoEncontrado;

    /*
     * Escanea un código de barras y abre el producto que lo tiene.
     * Busca en la lista ya cargada (datos locales), así funciona offline.
     */
    private async Task EscanearProductoAsync()
    {
        try
        {
            escaneando = true;
            errorMessage = null;
            codigoNoEncontrado = null;

            var resultado = await Scanner.ScanAsync(BarcodeScanKind.CodigoBarras);

            if (resultado is null)
                return; // cancelado

            var producto = productos.FirstOrDefault(p =>
                string.Equals(p.Codigo?.Trim(), resultado.Value, StringComparison.OrdinalIgnoreCase));

            if (producto is not null)
            {
                Navigation.NavigateTo($"/productos/editar/{producto.LocalId}");
                return;
            }

            codigoNoEncontrado = resultado.Value;
        }
        catch (DeviceFeatureException ex)
        {
            errorMessage = ex.Message;
        }
        catch (Exception ex)
        {
            errorMessage = $"No fue posible leer el código. {ex.Message}";
        }
        finally
        {
            escaneando = false;
        }
    }

    private void CrearConCodigoEscaneado()
    {
        var codigo = Uri.EscapeDataString(codigoNoEncontrado ?? string.Empty);

        Navigation.NavigateTo($"/productos/crear?codigo={codigo}");
    }

    private void NuevoProducto()
    {
        Navigation.NavigateTo(
            "/productos/crear");
    }

    private void OnConnectivityChanged()
    {
        _ = InvokeAsync(
            SincronizarAlReconectarAsync);
    }

    private async Task SincronizarAlReconectarAsync()
    {
        if (!Connectivity.IsOnline)
        {
            StateHasChanged();
            return;
        }

        await _loadLock.WaitAsync();

        try
        {
            errorMessage = null;

            await ProductoSync.SynchronizeAsync();

            productos =
                await ProductoService.ObtenerTodosAsync();
        }
        catch (UnauthorizedAccessException)
        {
            Navigation.NavigateTo("/login");
        }
        catch (HttpRequestException e)
        {
            errorMessage =
                $"No fue posible sincronizar los productos: {e.Message}";
        }
        catch (Exception e)
        {
            errorMessage =
                $"Error inesperado al sincronizar: {e.Message}";
        }
        finally
        {
            _loadLock.Release();

            StateHasChanged();
        }
    }

    public void Dispose()
    {
        Connectivity.ConnectivityChanged -=
            OnConnectivityChanged;

        _loadLock.Dispose();
    }
}
