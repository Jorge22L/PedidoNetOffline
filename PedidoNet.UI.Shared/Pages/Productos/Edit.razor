@page "/productos/editar/{LocalId:guid}"
@attribute [Authorize]

@using PedidoNet.UI.Shared.Components.Productos
@using PedidoNet.UI.Shared.Models.Productos
@using PedidoNet.UI.Shared.Offline
@using PedidoNet.UI.Shared.Productos

@inject IProductoService ProductoService
@inject IConnectivityService Connectivity
@inject NavigationManager Navigation
@inject ICameraService Camera

<PageTitle>Editar producto</PageTitle>

<div class="container-fluid py-4">

    <PageHeader
        Title="Editar producto"
        Description="Actualiza la información del producto." />

    @if (isLoading)
    {
        <LoadingIndicator
            Message="Cargando producto..." />
    }
    else if (notFound)
    {
        <AlertMessage
            Variant="warning"
            Message="El producto no existe."
            Dismissible="false" />
    }
    else
    {
        <AlertMessage
            Message="@errorMessage"
            Dismissible="false" />

        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">

                <ProductoForm
                    Model="@model"
                    SubmitText="Guardar cambios"
                    IsSaving="@isSaving"
                    OnValidSubmit="GuardarAsync"
                    Cancel="Cancelar" />

                @*
                    Imágenes offline: fase posterior.
                    Solo se gestionan con conexión y cuando el producto
                    ya existe en el servidor (tiene ProductoId).
                *@
                @if (productoId.HasValue && Connectivity.IsOnline)
                {
                    <ProductoImageManager OnUpload="SubirImagenAsync" />
                    @if (Camera.IsSupported)
                    {
                        <div class="mt-3 d-flex gap-2">
                            <button type="button" class="btn btn-outline-primary"
                            disabled="@subiendoFoto" @onclick="TomarFotoAsync">
                            Tomar Foto
                            </button>
                        </div>

                        @if(ultimaFoto is not null)
                        {
                            <img src="@ultimaFoto.ToDataUrl()" alt="Última foto"
                            class="img-thumbnail mt-3" style="max-height: 200px;"/>
                        }
                    }
                }
                else
                {
                    <AlertMessage
                        Variant="info"
                        Message="Las imágenes solo pueden gestionarse con conexión y cuando el producto ya fue sincronizado."
                        Dismissible="false" />
                }

            </div>
        </div>
    }

</div>

@code {
    [Parameter]
    public Guid LocalId { get; set; }

    private int? productoId;

    private ProductoFormModel model = new();

    private bool isLoading = true;
    private bool isSaving;
    private bool notFound;
    private string? errorMessage;

    private DevicePhoto? ultimaFoto;
    private bool subiendoFoto;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var producto =
                await ProductoService.ObtenerPorLocalIdAsync(LocalId);

            if (producto is null)
            {
                notFound = true;
                return;
            }

            productoId = producto.ProductoId;

            model = new ProductoFormModel
            {
                Codigo = producto.Codigo,
                Nombre = producto.Nombre,
                PrecioVenta = producto.PrecioVenta,
                Existencias = producto.Existencias,
                TieneIVA = producto.TieneIVA == true,
                TieneISC = producto.TieneISC == true
            };
        }
        catch (HttpRequestException ex)
        {
            errorMessage = ex.Message;
        }
        catch (Exception ex)
        {
            errorMessage = $"No fue posible cargar el producto. {ex.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task GuardarAsync()
    {
        try
        {
            isSaving = true;
            errorMessage = null;

            var request = new ActualizarProductoRequest
            {
                Codigo = model.Codigo,
                Nombre = model.Nombre,
                PrecioVenta = model.PrecioVenta,
                Existencias = model.Existencias,
                TieneIVA = model.TieneIVA,
                TieneISC = model.TieneISC
            };

            await ProductoService.ActualizarAsync(
                LocalId,
                request);

            Navigation.NavigateTo("/productos");
        }
        catch (HttpRequestException ex)
        {
            errorMessage = ex.Message;
        }
        catch (Exception ex)
        {
            errorMessage = $"No fue posible guardar el producto. {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private void Cancelar()
    {
        Navigation.NavigateTo("/productos");
    }

    private async Task SubirImagenAsync(ProductoImageUpload image)
    {
        if (!productoId.HasValue)
        {
            return;
        }

        try
        {
            errorMessage = null;

            await ProductoService.SubirImagenAsync(productoId.Value, image);
        }
        catch(UnauthorizedAccessException)
        {
            Navigation.NavigateTo("/login");
        }
        catch(HttpRequestException ex)
        {
            errorMessage = $"No fue posible subir la imagen. {ex.Message}";
        }
    }

    private async Task TomarFotoAsync()
    {
        if (!productoId.HasValue)
            return;

        try
        {
            subiendoFoto = true;
            errorMessage = null;

            var foto = await Camera.CapturePhotoAsync();

            if(foto is null)
            {
                return; // Cancelado
            }
            await ProductoService.SubirImagenAsync(productoId.Value, new ProductoImageUpload
                {
                    Stream = new MemoryStream(foto.Content),
                    FileName = foto.FileName,
                    ContentType = foto.ContentType,
                    Length = foto.Content.Length,
                    EsPrincipal = false
                });

            ultimaFoto = foto;
        }
        catch (DeviceFeatureException e)
        {
            errorMessage = e.Message;
        }
        catch (UnauthorizedAccessException)
        {
            Navigation.NavigateTo("/login");
        }
        catch (HttpRequestException e)
        {
            errorMessage = $"No fue posible subir la foto. {e.Message}";
        }
        finally
        {
            subiendoFoto = false;
        }
    }
}
