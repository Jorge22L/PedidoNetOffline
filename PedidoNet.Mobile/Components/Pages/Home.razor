@page "/"
@using PedidoNet.UI.Shared.Auth

@inject AuthApiClient AuthApiClient
@inject ITokenStorage TokenStorage

<div>
    <label>Usuario</label>
    <input @bind="usuario" />
</div>

<div>
    <label>Contraseña</label>
    <input type="password" @bind="password" />
</div>

<button @onclick="ProbarLogin">
    Probar Login
</button>

<p>@mensaje</p>

@code {
    private string usuario = string.Empty;
    private string password = string.Empty;
    private string mensaje = "Sin probar";

    private async Task ProbarLogin()
    {
        try
        {
            mensaje = "Autenticando...";

            var request = new LoginRequest
            {
                NombreUsuario = usuario,
                Password = password
            };

            var response = await AuthApiClient.LoginAsync(request);

            if (response is null)
            {
                mensaje = "No se recibió respuesta del servidor.";
                return;
            }

            if (!response.Success || response.Data is null)
            {
                mensaje = response.Message ?? "Usuario o contraseña incorrectos.";
                return;
            }

            await TokenStorage.SaveAsync(response.Data);

            mensaje =
                $"Bienvenido {response.Data.NombreUsuario}. Rol: {response.Data.Rol}";
        }
        catch (Exception e)
        {
            mensaje = $"Error: {e.Message}";
        }
    }
}