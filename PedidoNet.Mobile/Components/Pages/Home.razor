@page "/"
@using PedidoNet.UI.Shared.Auth

@inject IAuthService AuthService

<div>
    <label>Usuario</label>
    <input @bind="usuario" />
</div>

<div>
    <label>Contraseña</label>
    <input type="password" @bind="password" />
</div>

<button @onclick="ProbarLogin">
    Probar Login
</button>

<p>@mensaje</p>

@code {
    private string usuario = string.Empty;
    private string password = string.Empty;
    private string mensaje = "Sin probar";

    private async Task ProbarLogin()
    {
        try
        {
            mensaje = "Autenticando...";

            var request = new LoginRequest
            {
                NombreUsuario = usuario,
                Password = password
            };

            var loginCorrecto =
                await AuthService.LoginAsync(request);

            if (!loginCorrecto)
            {
                mensaje = "Usuario o contraseña incorrectos.";
                return;
            }

            var session =
                await AuthService.GetSessionAsync();

            if (session is null)
            {
                mensaje = "No fue posible recuperar la sesión.";
                return;
            }

            mensaje =
                $"Bienvenido {session.NombreUsuario}. Rol: {session.Rol}";
        }
        catch (Exception e)
        {
            mensaje = $"Error: {e.Message}";
        }
    }
}