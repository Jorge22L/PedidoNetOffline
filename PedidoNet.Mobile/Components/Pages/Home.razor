@page "/"
@using PedidoNet.UI.Shared.Auth
@using PedidoNet.UI.Shared.Components.Auth
@inject IAuthService AuthService
@inject PedidoNet.Mobile.Service.Api.ApiClient ApiClient

<LoginForm />

<button @onclick="ProbarApiProtegida">
    Probar API protegida
</button>
<p>@mensajeApi</p>

@code {
    private string mensajeApi = string.Empty;

    private async Task ProbarApiProtegida()
    {
        try
        {
            using var response =
                await ApiClient.GetAsync(
                    "api/v1/Producto");

            mensajeApi =
                $"Status API: {(int)response.StatusCode} " +
                $"{response.StatusCode}";
        }
        catch (Exception ex)
        {
            mensajeApi =
                $"Error API: {ex.Message}";
        }
    }
}