@page "/"
@using PedidoNet.UI.Shared.Auth
@using PedidoNet.UI.Shared.Components.Auth
@using PedidoNet.UI.Shared.Productos

@inject ProductosApiClient ProductosApiClient
@inject IAuthService AuthService
@inject PedidoNet.Mobile.Service.Api.ApiClient ApiClient

<LoginForm />

<button @onclick="ProbarApiProtegida">
    Probar API protegida
</button>
<p>@mensajeApi</p>

<button @onclick="ProbarProductos">
    Probar productos
</button>

<p>@mensajeProductos</p>

@code {
    private string mensajeApi = string.Empty;

    private async Task ProbarApiProtegida()
    {
        try
        {
            using var response =
                await ApiClient.GetAsync(
                    "api/v1/Producto");

            mensajeApi =
                $"Status API: {(int)response.StatusCode} " +
                $"{response.StatusCode}";
        }
        catch (Exception ex)
        {
            mensajeApi =
                $"Error API: {ex.Message}";
        }
    }

    private string mensajeProductos = string.Empty;

private async Task ProbarProductos()
{
    try
    {
        var productos =
            await ProductosApiClient.GetAllAsync();

        mensajeProductos =
            $"Productos encontrados: {productos.Count}";
    }
    catch (Exception ex)
    {
        mensajeProductos =
            $"Error productos: {ex.Message}";
    }
}
}