@page "/productos"
@implements IDisposable

@using PedidoNet.Web.Models.Productos
@using PedidoNet.Web.Services
@using PedidoNet.Web.Services.Offline
@using PedidoNet.Web.Services.Productos

@inject IProductoService ProductoService
@inject ProductoSyncService ProductoSync
@inject ConnectivityService Connectivity
@inject NavigationManager Navigation

<div class="container-fluid px-3 px-md-4 py-4">
    <PageHeader Title="Catálogo de productos"
                Description="Administra los productos disponibles.">

        <Actions>
            <button type="button"
                    class="btn btn-primary px-3"
                    @onclick="NuevoProducto">
                Nuevo producto
            </button>
        </Actions>

    </PageHeader>
    @if (!Connectivity.IsOnline)
    {
         <div class="offline-banner mb-4">
             <div>
                 <div class="fw-bold">
                     Estás trabajando sin conexión.
                 </div>

                 <div class="small">
                     Puedes continuar usando la aplicación, pero las operaciones requieren conexión con la API.
                 </div>
             </div>
         </div>
    }

    @if (isLoading)
    {
        <LoadingIndicator Message="Cargando productos..." />
    }
    else if (errorMessage is not null)
    {
        <AlertMessage Message="@errorMessage"
                      Dismissible="false" />
    }
    else if (productos.Count == 0)
    {
        <AlertMessage Variant="info"
                      Message="No hay productos registrados."
                      Dismissible="false" />
    }
    else
    {
        <DataTable TItem="PedidoNet.Web.Models.Productos.ProductosDto"
                   Items="@productos"
                   ColumnCount="7"
                   EmptyMessage="No hay productos registrados.">

            <Header>
                <th>Código</th>
                <th>Producto</th>
                <th>Precio</th>
                <th>Existencias</th>
                <th>IVA</th>
                <th>ISC</th>
                <th>Acciones</th>
            </Header>

            <RowTemplate Context="producto">

                <td>@producto.Codigo</td>

                <td class="fw-semibold">
                    @producto.Nombre
                </td>

                <td class="text-end">
                    @producto.PrecioVenta.ToString("N2")
                </td>

                <td class="text-center">
                    @producto.Existencias
                </td>

                <td class="text-center">
                    @(producto.TieneIVA == true ? "Sí" : "No")
                </td>

                <td class="text-center">
                    @(producto.TieneISC == true ? "Sí" : "No")
                </td>

                <td class="text-end">
                    <button type="button"
                            class="btn btn-sm btn-outline-primary me-2"
                            @onclick="@(() => OnEditar(producto))">
                        Editar
                    </button>

                    <button type="button"
                            class="btn btn-sm btn-outline-danger"
                            @onclick="@(() => OnEliminar(producto))"
                            disabled="@(!Connectivity.IsOnline)">
                        Eliminar
                    </button>
                </td>

            </RowTemplate>

        </DataTable>
    }
</div>

@code {
    private List<ProductosDto> productos = [];

    private bool isLoading = true;

    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        Connectivity.ConnectivityChanged += OnConnectivityChanged;

        await CargarProductosAsync();
    }

    private void OnEditar(ProductosDto producto)
    {
        Navigation.NavigateTo(
            $"/productos/editar/{producto.LocalId}");
    }

    private async Task OnEliminar(ProductosDto producto)
    {
        await ProductoService.EliminarAsync(
            producto.LocalId);

        await CargarProductosAsync();
    }

    private async Task CargarProductosAsync()
    {
        
        try
        {
            isLoading = true;
            errorMessage = null;

            productos = await ProductoService.ObtenerTodosAsync();
        }
        catch (UnauthorizedAccessException)
        {
            Navigation.NavigateTo("/login");
        }
        catch(HttpRequestException e)
        {
            errorMessage = $"No fue posible consultar los productos ${e.Message}";
        }
        catch(Exception e)
        {
            errorMessage = $"Error inesperado: {e.Message}";
        }
        finally
        {
            isLoading = false;
        }
    }

    private void NuevoProducto()
    {
        Navigation.NavigateTo("/productos/crear");
    }

    public void Dispose()
    {
        Connectivity.ConnectivityChanged -= OnConnectivityChanged;
    }

    private void OnConnectivityChanged()
    {
        _ = InvokeAsync(async () =>
        {
            if (Connectivity.IsOnline)
            {
                try
                {
                    await ProductoSync.SynchronizeAsync();
                    productos = await ProductoService.ObtenerTodosAsync();
                }
                catch
                {

                }
            }

            StateHasChanged();
        });
    }
}
