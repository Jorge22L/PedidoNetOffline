<Router AppAssembly="@typeof(App).Assembly"
        AdditionalAssemblies="@AdditionalAssemblies"
        NotFoundPage="typeof(Pages.NotFound)">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
            <NotAuthorized>
                <RedirectToLogin />
            </NotAuthorized>
            <Authorizing>
                <LoadingIndicator Message="Validando sesión..." />
            </Authorizing>
        </AuthorizeRouteView>
        <FocusOnNavigate RouteData="@routeData" Selector="h1" />
    </Found>
</Router>

@code {
    // Páginas compartidas (Login, Productos) que viven en PedidoNet.UI.Shared.
    private static readonly System.Reflection.Assembly[] AdditionalAssemblies =
    [
        typeof(PedidoNet.UI.Shared.Productos.IProductoService).Assembly
    ];
}
